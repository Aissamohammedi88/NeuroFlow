def detect_intent(prompt: str) -> str:
p = prompt.lower()
for keywords, intent in INTENTS:
for k in keywords:
if k in p:
return intent
return "default"


def reponse_locale(prompt: str, contexte: List[Message]) -> str:
if not prompt or not prompt.strip():
return "Pose-moi une question."
intent = detect_intent(prompt)
if intent in RESPONSES:
return random.choice(RESPONSES[intent])
return random.choice(DEFAULT_RESPONSES).format(prompt=prompt[:120], n=len(contexte))


