@dataclass
class Message:
id: str
role: str
contenu: str
timestamp: str
tokens: int = 0


@dataclass
class Session:
id: str
nom: str
cree: str
messages: List[Message] = field(default_factory=list)


SESSIONS: Dict[str, Session] = {}
SESSIONS_LOCK = threading.RLock()


def get_session(sid: Optional[str]) -> Session:
with SESSIONS_LOCK:
if sid and sid in SESSIONS:
return SESSIONS[sid]
if sid:
rows = DBM.query("SELECT id,nom,cree FROM sessions WHERE id=?", (sid,))
if rows:
s = Session(id=rows[0]["id"], nom=rows[0]["nom"], cree=rows[0]["cree"])
for m in DBM.get_messages(s.id):
s.messages.append(Message(**m))
SESSIONS[s.id] = s
return s
nid = str(uuid.uuid4())[:8]
now = datetime.datetime.now(datetime.timezone.utc).isoformat()
s = Session(id=nid, nom="Session " + nid, cree=now)
SESSIONS[nid] = s
DBM.upsert_session(nid, s.nom, now)
return s


def ajouter_message(sid: str, role: str, contenu: str) -> Message:
s = get_session(sid)
m = Message(
id=str(uuid.uuid4())[:12],
role=role,
contenu=contenu,
timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(),
tokens=len(contenu.split()),
)
with SESSIONS_LOCK:
s.messages.append(m)
if len(s.messages) > MAX_MESSAGES_PER_SESSION:
s.messages = s.messages[-MAX_MESSAGES_PER_SESSION:]
DBM.insert_message(m, sid)
DBM.incr_session_messages(sid)
try:
with open(HIST, "a", encoding="utf-8") as f:
f.write(json.dumps({"session": sid, **asdict(m)}, ensure_ascii=False) + "\n")
except OSError:
pass
return m


