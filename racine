function afficherMessage(role, contenu){
const box = document.getElementById('messages');
const div = document.createElement('div');
div.className = 'msg ' + role;
const av = role === 'user' ? 'M' : 'AI';
div.innerHTML = '<div class="avatar">'+av+'</div><div class="bubble"></div>';
div.querySelector('.bubble').textContent = contenu;
box.appendChild(div);
box.scrollTop = box.scrollHeight;
}

async function envoyer(){
const input = document.getElementById('input');
const txt = input.value.trim();
if (!txt) return;
input.value = '';
autoGrow(input);
afficherMessage('user', txt);
document.getElementById('send').disabled = true;

const box = document.getElementById('messages');
const loading = document.createElement('div');
loading.className = 'msg assistant';
loading.innerHTML = '<div class="avatar">AI</div><div class="bubble"><span class="typing"></span></div>';
box.appendChild(loading);
box.scrollTop = box.scrollHeight;

try {
const r = await fetch('/api/chat', {
method:'POST',
headers:{'Content-Type':'application/json'},
body: JSON.stringify({message: txt, session: session})
});
const data = await r.json();
box.removeChild(loading);
if (data.reponse) afficherMessage('assistant', data.reponse);
if (data.session) { session = data.session; }
chargerSessions();
} catch(e){
box.removeChild(loading);
afficherMessage('assistant', 'Erreur reseau.');
}
document.getElementById('send').disabled = false;
}

