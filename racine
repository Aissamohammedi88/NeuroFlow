def lire_stats() -> Dict[str, Any]:
stats = {"cpu": 0.0, "ram": 0.0, "disk": 0.0, "uptime": 0, "load": [0, 0, 0], "ts": time.time()}
try:
import psutil
stats["cpu"] = psutil.cpu_percent(interval=None)
stats["ram"] = psutil.virtual_memory().percent
stats["disk"] = psutil.disk_usage("/").percent
stats["uptime"] = int(time.time() - psutil.boot_time())
stats["load"] = [round(x, 2) for x in psutil.getloadavg()]
except Exception:
try:
with open("/proc/loadavg") as f:
parts = f.read().split()
stats["cpu"] = float(parts[0]) * 10
stats["load"] = [float(parts[0]), float(parts[1]), float(parts[2])]
with open("/proc/uptime") as f:
stats["uptime"] = int(float(f.read().split()[0]))
with open("/proc/meminfo") as f:
mem = {}
for line in f:
if ":" in line:
k, v = line.split(":", 1)
mem[k.strip()] = v.strip()
total = int(mem.get("MemTotal", "1").split()[0])
avail = int(mem.get("MemAvailable", "0").split()[0])
if total > 0:
stats["ram"] = round((total - avail) / total * 100, 2)
except Exception:
pass
return stats


