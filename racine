class DBManager:
def __init__(self, path: Path):
self.path = path
self.lock = threading.RLock()
self.conn = sqlite3.connect(str(path), check_same_thread=False, timeout=30)
self.conn.row_factory = sqlite3.Row
self._migrate()

def _migrate(self):
with self.lock:
self.conn.executescript("""
CREATE TABLE IF NOT EXISTS sessions (
id TEXT PRIMARY KEY,
nom TEXT NOT NULL,
cree TEXT NOT NULL,
updated TEXT NOT NULL,
messages_count INTEGER DEFAULT 0
);
CREATE TABLE IF NOT EXISTS messages (
id TEXT PRIMARY KEY,
session_id TEXT NOT NULL,
role TEXT NOT NULL,
contenu TEXT NOT NULL,
timestamp TEXT NOT NULL,
tokens INTEGER DEFAULT 0
);
CREATE TABLE IF NOT EXISTS events (
id INTEGER PRIMARY KEY AUTOINCREMENT,
ts TEXT NOT NULL,
type TEXT NOT NULL,
data TEXT
);
CREATE INDEX IF NOT EXISTS idx_msg_session ON messages(session_id);
CREATE INDEX IF NOT EXISTS idx_msg_ts ON messages(timestamp);
CREATE INDEX IF NOT EXISTS idx_evt_ts ON events(ts);
""")
self.conn.commit()

def execute(self, sql: str, params: Tuple = ()) -> sqlite3.Cursor:
with self.lock:
cur = self.conn.execute(sql, params)
self.conn.commit()
return cur

def query(self, sql: str, params: Tuple = ()) -> List[sqlite3.Row]:
with self.lock:
return self.conn.execute(sql, params).fetchall()

def log_event(self, type_: str, data: str = ""):
self.execute("INSERT INTO events(ts,type,data) VALUES(?,?,?)",
(datetime.datetime.now(datetime.timezone.utc).isoformat(), type_, data))

def upsert_session(self, sid: str, nom: str, cree: str):
self.execute(
"INSERT OR IGNORE INTO sessions(id,nom,cree,updated,messages_count) VALUES(?,?,?,?,0)",
(sid, nom, cree, cree),
)

def incr_session_messages(self, sid: str):
self.execute("UPDATE sessions SET messages_count = messages_count + 1, updated = ? WHERE id = ?",
(datetime.datetime.now(datetime.timezone.utc).isoformat(), sid))

def insert_message(self, m: "Message", sid: str):
self.execute(
"INSERT OR REPLACE INTO messages(id,session_id,role,contenu,timestamp,tokens) VALUES(?,?,?,?,?,?)",
(m.id, sid, m.role, m.contenu, m.timestamp, m.tokens),
)

def get_messages(self, sid: str, limit: int = 1000) -> List[Dict[str, Any]]:
rows = self.query("SELECT id,role,contenu,timestamp,tokens FROM messages WHERE session_id=? ORDER BY timestamp ASC LIMIT ?", (sid, limit))
return [dict(r) for r in rows]

def list_sessions(self) -> List[Dict[str, Any]]:
rows = self.query("SELECT id,nom,cree,updated,messages_count FROM sessions ORDER BY updated DESC")
return [dict(r) for r in rows]

def delete_session(self, sid: str):
self.execute("DELETE FROM messages WHERE session_id=?", (sid,))
self.execute("DELETE FROM sessions WHERE id=?", (sid,))

def search(self, query: str, limit: int = 100) -> List[Dict[str, Any]]:
rows = self.query(
"SELECT session_id,id,role,contenu,timestamp FROM messages WHERE contenu LIKE ? ORDER BY timestamp DESC LIMIT ?",
("%" + query + "%", limit),
)
return [dict(r) for r in rows]

def stats(self) -> Dict[str, Any]:
s = self.query("SELECT COUNT(*) AS n FROM sessions")[0]["n"]
m = self.query("SELECT COUNT(*) AS n FROM messages")[0]["n"]
e = self.query("SELECT COUNT(*) AS n FROM events")[0]["n"]
return {"sessions": s, "messages": m, "events": e}

def close(self):
with self.lock:
self.conn.close()


